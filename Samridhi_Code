Sub CreateSlidesForSelectedWorkshops()
    Dim pptApp As Object
    Dim pptPres As Object
    Dim pptLayout As Object
    Dim dataWs As Worksheet
    Dim templatePath As String
    Dim d As Object
    Dim lay As Object
    Dim cell As Range
    Dim workshopName As String
    Dim facilitatorName As String
    Dim workshopDate As String
    Dim uniqueWorkshops As Object   ' Scripting.Dictionary, late-bound
    Dim comboKey As String
    Dim info As Variant
    Dim workshopRange As Range

    Set dataWs = ThisWorkbook.Sheets("Data")

    templatePath = "Z:\Illinois Leadership Center\Student Staff\ART\Reports - Workshops\Automation\New Template September 16.potx"

    If TypeName(Selection) <> "Range" Then
        MsgBox "Please select a range of cells containing workshop names first.", vbExclamation
        Exit Sub
    End If

    ' --- Build a list of UNIQUE workshop INSTANCES from the selection ---
    ' A workshop instance = Name + Facilitator + Date, since the same
    ' workshop name can occur multiple times with different facilitators/dates.
    Set uniqueWorkshops = CreateObject("Scripting.Dictionary")

    For Each cell In Selection
        workshopName = CleanText(dataWs.Cells(cell.Row, "E").Value)
        facilitatorName = CleanText(dataWs.Cells(cell.Row, "G").Value)
        workshopDate = CleanText(dataWs.Cells(cell.Row, "F").Value)

        If workshopName <> "" Then
            comboKey = workshopName & "||" & facilitatorName & "||" & workshopDate
            If Not uniqueWorkshops.Exists(comboKey) Then
                uniqueWorkshops.Add comboKey, Array(workshopName, facilitatorName, workshopDate)
            End If
        End If
    Next cell

    If uniqueWorkshops.Count = 0 Then
        MsgBox "No workshop names found in selection.", vbExclamation
        Exit Sub
    End If

    Debug.Print "Unique workshop instances found: " & uniqueWorkshops.Count
    For Each info In uniqueWorkshops.Items
        Debug.Print " - " & info(0) & " | " & info(1) & " | " & info(2)
    Next info

    On Error Resume Next
    Set pptApp = GetObject(, "PowerPoint.Application")
    If pptApp Is Nothing Then
        Set pptApp = CreateObject("PowerPoint.Application")
    End If
    On Error GoTo 0

    pptApp.Visible = True

    Set pptPres = pptApp.Presentations.Open(templatePath)

    For Each d In pptPres.Designs
        For Each lay In d.SlideMaster.CustomLayouts
            If Trim(lay.Name) = "Workshop Layout" Then
                Set pptLayout = lay
            End If
        Next lay
    Next d

    If pptLayout Is Nothing Then
        Set pptLayout = pptPres.Designs(1).SlideMaster.CustomLayouts(1)
    End If

    For Each info In uniqueWorkshops.Items
        workshopName = info(0)
        facilitatorName = info(1)
        workshopDate = info(2)

        Set workshopRange = BuildWorkshopRange(dataWs, workshopName, facilitatorName, workshopDate)

        GenerateWorkshopSlide pptPres, pptLayout, dataWs, workshopName, facilitatorName, workshopDate, workshopRange
    Next info

    Set pptPres = Nothing
    Set pptApp = Nothing

    MsgBox "Generated " & uniqueWorkshops.Count & " slide(s) for unique workshop instance(s) :)", vbInformation
End Sub

' Trim() only strips LEADING/TRAILING spaces - it does NOT remove an embedded
' line break (e.g. an accidental Alt+Enter typed into a Data-sheet cell).
' A hidden vbCr/vbLf inside a workshop name/facilitator/date would ride
' along silently through every Trim() call and then show up as an actual
' newline once inserted into a PowerPoint textbox - which is exactly why
' this exists. Used everywhere a workshop-name/facilitator/date value is
' read from the Data sheet, both for matching rows and for display, so a
' stray character in one cell can't (a) silently break row-matching by
' making the "cleaned" workshopName param no longer equal the "dirty" raw
' cell text, or (b) leak an unwanted line break into a slide.
Private Function CleanText(s As String) As String
    CleanText = Trim(Replace(Replace(Replace(CStr(s), vbCrLf, " "), vbCr, " "), vbLf, " "))
End Function

' Returns a Union range of every row in dataWs whose Name (E), Facilitator (G),
' and Date (F) all match the given workshop instance. This range is what gets
' passed downstream as "workshopRange" - GetAllValuesInRange uses it to pull
' feedback text (col AU) only from rows belonging to THIS specific instance.
Private Function BuildWorkshopRange(dataWs As Worksheet, workshopName As String, facilitatorName As String, workshopDate As String) As Range
    Dim lastRow As Long
    Dim r As Long
    Dim result As Range

    lastRow = dataWs.Cells(dataWs.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow
        If CleanText(dataWs.Cells(r, "E").Value) = workshopName _
           And CleanText(dataWs.Cells(r, "G").Value) = facilitatorName _
           And CleanText(dataWs.Cells(r, "F").Value) = workshopDate Then

            If result Is Nothing Then
                Set result = dataWs.Cells(r, "E")
            Else
                Set result = Application.Union(result, dataWs.Cells(r, "E"))
            End If
        End If
    Next r

    Set BuildWorkshopRange = result
End Function

Private Sub GenerateWorkshopSlide(pptPres As Object, pptLayout As Object, dataWs As Worksheet, workshopName As String, facilitatorName As String, workshopDate As String, workshopRange As Range)
    Dim pptSlide As Object
    Dim i As Long
    Dim calcWs As Worksheet

    Set calcWs = ThisWorkbook.Sheets("Calculations")

    Set pptSlide = pptPres.Slides.AddSlide(pptPres.Slides.Count + 1, pptLayout)

    If pptSlide.Shapes.Count = 0 And pptLayout.Shapes.Count > 0 Then
        For i = 1 To pptLayout.Shapes.Count
            ' Skip the chart here - it gets pasted separately, in isolation,
            ' right below. Copy/Paste through the clipboard is unreliable
            ' when called many times back-to-back (see the arrow-duplication
            ' notes elsewhere in this module), and that unreliability hits
            ' the chart hardest because it carries a full embedded OLE
            ' package, not just a picture/shape. Sweeping it into this same
            ' tight loop alongside every other layout shape was very likely
            ' why the chart's embedded data ended up aliased/shared across
            ' slides (all charts showing the LAST workshop's numbers), and
            ' why trying to Duplicate that already-pasted, possibly
            ' not-yet-fully-committed chart afterward sometimes produced no
            ' working chart at all.
            If Trim(pptLayout.Shapes(i).Name) <> "Learning Outcomes Chart" Then
                pptLayout.Shapes(i).Copy
                pptSlide.Shapes.Paste
            End If
        Next i

        ' --- Paste the chart on its own: one isolated Copy/Paste, nothing
        ' else touching the clipboard immediately before or after it,
        ' sourced straight from the untouched layout master. Same principle
        ' as the arrow templates - one clean operation per slide. ---
        On Error Resume Next
        pptLayout.Shapes("Learning Outcomes Chart").Copy
        pptSlide.Shapes.Paste
        On Error GoTo 0
    End If

    ' --- Diagnostic: list every shape now on the slide, with its Name AND
    ' its ResultArrow tag (if any), so we can see exactly what's inherited
    ' from the layout before any cleanup runs. ---
    Debug.Print "---- Shapes on new slide before cleanup ----"
    For i = 1 To pptSlide.Shapes.Count
        Debug.Print i & ": Name=[" & pptSlide.Shapes(i).Name & "] Tag=[" & pptSlide.Shapes(i).Tags("ResultArrow") & "]"
    Next i

    ' --- Clear out any leftover RESULT arrows using their Tag, not their Name.
    ' PowerPoint does not enforce unique shape names, so relying on Name alone
    ' to find "the" Facilitator/Content/Recommended arrow is unreliable if a
    ' stale shape with a matching name is lingering (e.g. inherited from the
    ' layout, or left over from an earlier run). Tags are an explicit
    ' key/value store on the shape that we set ourselves, so a match here is
    ' unambiguous regardless of what the shape happens to be named. ---
    RemoveAllShapesTagged pptSlide, "Facilitator Arrow"
    RemoveAllShapesTagged pptSlide, "Content Arrow"
    RemoveAllShapesTagged pptSlide, "Recommended Arrow"

    Dim shpFacilitator As Object
    Dim shpContent As Object
    Dim shpRecommended As Object
    Dim shpInfo As Object
    Dim shpFeedback As Object
    Dim shpChart As Object

    On Error Resume Next
    Set shpFacilitator = pptSlide.Shapes("Facilitator Percent")
    Set shpContent = pptSlide.Shapes("Content Percent")
    Set shpRecommended = pptSlide.Shapes("Recommended Percent")
    Set shpInfo = pptSlide.Shapes("Workshop Information")
    Set shpFeedback = pptSlide.Shapes("Feedback Textbox")
    Set shpChart = pptSlide.Shapes("Learning Outcomes Chart")
    On Error GoTo 0

    ' --- Percentages (scoped to THIS workshop instance only) ---
    Dim facilitatorPct As Double
    Dim contentPct As Double
    Dim recommendedPct As Double

    facilitatorPct = ComputeAgreePercent(dataWs, workshopName, facilitatorName, workshopDate, "AR")
    contentPct = ComputeAgreePercent(dataWs, workshopName, facilitatorName, workshopDate, "AS")
    recommendedPct = ComputeAgreePercent(dataWs, workshopName, facilitatorName, workshopDate, "AT")

    UpdatePercentLine shpFacilitator, Format(facilitatorPct, "0%")
    UpdatePercentLine shpContent, Format(contentPct, "0%")
    UpdatePercentLine shpRecommended, Format(recommendedPct, "0%")

    ' --- Comparison arrows (vs. workshop-type averages on Calculations sheet) ---
    Dim facAvg As Double, contAvg As Double, recAvg As Double

    GetWorkshopAverages calcWs, workshopName, facAvg, contAvg, recAvg

    UpdateComparisonArrows pptSlide, facilitatorPct, contentPct, recommendedPct, facAvg, contAvg, recAvg

    ' --- Comparison textboxes (sentence version of the same Above/Below/Average
    ' result used for the arrows, so text and arrows always agree) ---
    UpdateComparisonTextBoxes pptSlide, facilitatorPct, contentPct, recommendedPct, facAvg, contAvg, recAvg

    ' --- Response count: workshopRange is a Union of one cell per matching row,
    ' so .Cells.Count IS the response count for this specific instance. ---
    Dim responseCount As Long
    responseCount = workshopRange.Cells.Count

    ' --- Feedback text pulled from column AU, scoped to this instance's rows ---
    Dim feedbackValues As Collection
    Set feedbackValues = GetAllValuesInRange(workshopRange)

    UpdateWorkshopInfoBox shpInfo, workshopName, facilitatorName, workshopDate, responseCount
    UpdateFeedbackTextBox shpFeedback, feedbackValues

    ' --- Learning outcomes chart: rebuild its 3x5 data table for this workshop ---
    UpdateWorkshopChart shpChart, workshopName, dataWs, calcWs

    Set pptSlide = Nothing
End Sub

' Now scoped to a specific workshop INSTANCE (name + facilitator + date),
' not just name, so stats aren't blended across two sessions with the same name.
Function ComputeAgreePercent(dataWs As Worksheet, workshopName As String, facilitatorName As String, workshopDate As String, colLetter As String) As Double
    Dim lastRow As Long
    Dim r As Long
    Dim agreeCount As Long
    Dim totalCount As Long
    Dim cellVal As String

    lastRow = dataWs.Cells(dataWs.Rows.Count, "E").End(xlUp).Row

    agreeCount = 0
    totalCount = 0

    For r = 2 To lastRow
        If CleanText(dataWs.Cells(r, "E").Value) = workshopName _
           And CleanText(dataWs.Cells(r, "G").Value) = facilitatorName _
           And CleanText(dataWs.Cells(r, "F").Value) = workshopDate Then

            cellVal = Trim(dataWs.Cells(r, colLetter).Value)
            If cellVal <> "" Then
                totalCount = totalCount + 1
                If cellVal = "Strongly agree" Or cellVal = "Somewhat agree" Then
                    agreeCount = agreeCount + 1
                End If
            End If
        End If
    Next r

    If totalCount = 0 Then
        ComputeAgreePercent = 0
    Else
        ComputeAgreePercent = agreeCount / totalCount
    End If
End Function

' Returns the value from the given column on the FIRST row matching the workshop name.
' (Left as-is; no longer called from GenerateWorkshopSlide since facilitator/date
' now come directly from the unique workshop-instance key, but kept in case it's
' used elsewhere.)
Function GetFirstMatchingValue(dataWs As Worksheet, workshopName As String, colLetter As String) As String
    Dim lastRow As Long
    Dim r As Long
    Dim val As String

    lastRow = dataWs.Cells(dataWs.Rows.Count, "E").End(xlUp).Row

    For r = 2 To lastRow
        If Trim(dataWs.Cells(r, "E").Value) = workshopName Then
            val = Trim(dataWs.Cells(r, colLetter).Value)
            If val <> "" Then
                GetFirstMatchingValue = val
                Exit Function
            End If
        End If
    Next r

    GetFirstMatchingValue = ""
End Function

' Replaces just the first line (the "98%" line) in a shape's text,
' keeping the label sentence below it (e.g. "believed the content
' was engaging.") completely intact. Percent line is set to 32pt,
' all other lines are set to 14pt.
Private Sub UpdatePercentLine(shp As Object, newPercentText As String)
    If shp Is Nothing Then
        Debug.Print "WARNING: percent shape not found, skipped."
        Exit Sub
    End If

    Dim fullText As String
    Dim lines() As String
    Dim lineBreak As String
    Dim paraCount As Long

    fullText = shp.TextFrame.TextRange.Text
    lineBreak = DetectLineBreak(fullText)

    lines = Split(fullText, lineBreak)
    lines(0) = newPercentText

    shp.TextFrame.TextRange.Text = Join(lines, lineBreak)

    ' --- Apply font sizes per paragraph ---
    paraCount = shp.TextFrame.TextRange.Paragraphs.Count

    shp.TextFrame.TextRange.Paragraphs(1).Font.Size = 32

    If paraCount > 1 Then
        shp.TextFrame.TextRange.Paragraphs(2, paraCount - 1).Font.Size = 14
        shp.TextFrame.TextRange.Paragraphs(2, paraCount - 1).Font.Bold = False
    End If
End Sub

' Detects which paragraph delimiter a PowerPoint TextRange actually uses.
Private Function DetectLineBreak(fullText As String) As String
    If InStr(fullText, vbCrLf) > 0 Then
        DetectLineBreak = vbCrLf
    ElseIf InStr(fullText, vbCr) > 0 Then
        DetectLineBreak = vbCr
    ElseIf InStr(fullText, vbLf) > 0 Then
        DetectLineBreak = vbLf
    Else
        DetectLineBreak = vbCr ' fallback default
    End If
End Function

Private Sub UpdateWorkshopInfoBox(shp As Object, workshopName As String, facilitatorName As String, workshopDate As String, responseCount As Long)
    If shp Is Nothing Then
        Debug.Print "WARNING: Workshop Information shape not found, skipped."
        Exit Sub
    End If

    Dim fullText As String
    Dim lines() As String
    Dim lineBreak As String
    Dim i As Long
    Dim spacer As String

    spacer = vbTab

    fullText = shp.TextFrame.TextRange.Text
    lineBreak = DetectLineBreak(fullText)

    lines = Split(fullText, lineBreak)

    Debug.Print "---- Workshop Information box lines (delimiter=" & Asc(lineBreak) & ") ----"
    For i = LBound(lines) To UBound(lines)
        Debug.Print i & ": [" & lines(i) & "]"
    Next i

    For i = LBound(lines) To UBound(lines)
        If InStr(lines(i), "Workshop:") > 0 And InStr(lines(i), workshopName) = 0 Then
            lines(i) = InsertAfterLabel(lines(i), "Workshop:", workshopName, spacer)
        End If

        If InStr(lines(i), "Facilitator:") > 0 And InStr(lines(i), facilitatorName) = 0 Then
            lines(i) = InsertAfterLabel(lines(i), "Facilitator:", facilitatorName, vbNullString)
        End If

        If InStr(lines(i), "Date:") > 0 And InStr(lines(i), workshopDate) = 0 Then
            lines(i) = InsertAfterLabel(lines(i), "Date:", workshopDate, spacer & spacer)
        End If

        If InStr(lines(i), "Responses:") > 0 And InStr(lines(i), CStr(responseCount)) = 0 Then
            lines(i) = InsertAfterLabel(lines(i), "Responses:", CStr(responseCount))
        End If
    Next i

    shp.TextFrame.TextRange.Text = Join(lines, lineBreak)

    ' --- Bold the category labels only; leave all other text non-bold ---
    Dim finalText As String
    Dim labels() As Variant
    Dim lbl As Variant
    Dim searchPos As Long
    Dim foundPos As Long
    Dim valueStart As Long
    Dim valueEnd As Long
    Dim lineBreakPos As Long

    finalText = shp.TextFrame.TextRange.Text
    shp.TextFrame.TextRange.Font.Bold = False

    labels = Array("Group:", "Workshop:", "Facilitator:", "Date:", "Attendees:", "Responses:", "Response Rate:")

    For Each lbl In labels
        searchPos = 1
        Do
            foundPos = InStr(searchPos, finalText, CStr(lbl))
            If foundPos = 0 Then Exit Do

            shp.TextFrame.TextRange.Characters(foundPos, Len(CStr(lbl))).Font.Bold = True

            ' Set font size 12 for Attendees, Responses, and Response Rate labels
            If CStr(lbl) = "Attendees:" Or CStr(lbl) = "Responses:" Or CStr(lbl) = "Response Rate:" Then
                shp.TextFrame.TextRange.Characters(foundPos, Len(CStr(lbl))).Font.Size = 12

                ' Find the value text that follows the label, up to the end of the line
                valueStart = foundPos + Len(CStr(lbl))
                lineBreakPos = InStr(valueStart, finalText, vbCr)
                If lineBreakPos = 0 Then
                    valueEnd = Len(finalText)
                Else
                    valueEnd = lineBreakPos - 1
                End If

                If valueEnd >= valueStart Then
                    With shp.TextFrame.TextRange.Characters(valueStart, valueEnd - valueStart + 1).Font
                        .Bold = False
                        .Size = 12
                    End With
                End If
            End If

            searchPos = foundPos + Len(CStr(lbl))
        Loop
    Next lbl
End Sub

' Inserts newValue right after the label (e.g. "Workshop:"), keeping
' everything else on the line untouched. separator controls what goes
' between the label and the value (defaults to a single space).
Private Function InsertAfterLabel(lineText As String, label As String, newValue As String, Optional separator As String = " ") As String
    Dim pos As Long
    pos = InStr(lineText, label)

    If pos = 0 Then
        InsertAfterLabel = lineText
        Exit Function
    End If

    Dim insertPos As Long
    insertPos = pos + Len(label)

    InsertAfterLabel = Left(lineText, insertPos) & separator & newValue & Mid(lineText, insertPos + 1)
End Function


' Collects every non-empty value from column AU on the Data sheet, restricted
' to whatever rows are present in dataRange. Handles BOTH a normal contiguous
' range AND a non-contiguous Union range (e.g. from BuildWorkshopRange), since
' it walks Areas/Rows rather than assuming a single contiguous block.
Public Function GetAllValuesInRange(dataRange As Range) As Collection
    Dim result As New Collection
    Dim ws As Worksheet
    Dim area As Range
    Dim rw As Range
    Dim auCell As Range

    Set ws = dataRange.Worksheet

    Debug.Print "---- Scanning " & dataRange.Address & " for non-empty AU values ----"

    For Each area In dataRange.Areas
        For Each rw In area.Rows
            Set auCell = ws.Cells(rw.Row, "AU")
            If Trim$(CStr(auCell.Value)) <> "" Then
                result.Add auCell.Value
                Debug.Print "Added: [" & auCell.Value & "] from " & auCell.Address
            End If
        Next rw
    Next area

    Debug.Print "Total non-empty values found: " & result.Count

    Set GetAllValuesInRange = result
End Function

' Populates a textbox shape with the list of values gathered by
' GetAllValuesInRange (or any Collection of values), as bullet points.
Public Sub UpdateFeedbackTextBox(shp As Object, values As Collection)
    If shp Is Nothing Then
        Debug.Print "WARNING: Feedback shape not found, skipped."
        Exit Sub
    End If

    Dim outputText As String
    Dim item As Variant
    Dim i As Long

    If values Is Nothing Then
        Debug.Print "WARNING: values Collection is Nothing, nothing to write."
        shp.TextFrame.TextRange.Text = "No feedback available."
        Exit Sub
    End If

    If values.Count = 0 Then
        Debug.Print "No feedback values to display."
        shp.TextFrame.TextRange.Text = "No feedback available."
        Exit Sub
    End If

    i = 1
    For Each item In values
        outputText = outputText & CStr(item)
        If i < values.Count Then
            outputText = outputText & vbCrLf
        End If
        i = i + 1
    Next item

    Debug.Print "---- Writing " & values.Count & " feedback line(s) to shape ----"
    shp.TextFrame.TextRange.Text = outputText
End Sub

' Looks up the Facilitator/Program(Content)/Recommend averages for a workshop
' NAME on the Calculations sheet, using a fixed name -> (Facilitator cell,
' Content cell, Recommend cell) map, since each workshop block sits at a
' hardcoded spot on that sheet rather than a computable offset.
'
' NOTE: every block below uses the SAME row for all three cells (e.g.
' "Q10/R10/S10") EXCEPT "CliftonStrengths for Students: Self-Discovery",
' which was given as Q4/R5/S6 - three different rows. That's kept exactly
' as specified; flagging it here in case it was meant to be Q4/R4/S4 like
' the rest.
Private Sub GetWorkshopAverages(calcWs As Worksheet, workshopName As String, ByRef facAvg As Double, ByRef contAvg As Double, ByRef recAvg As Double)
    Dim map As Object
    Set map = CreateObject("Scripting.Dictionary")
    map.CompareMode = vbTextCompare ' case-insensitive keys

    map.Add "CliftonStrengths for Students: Self-Discovery", Array("Q4", "R5", "S6")
    map.Add "Addressing Conflict in Teams", Array("Q10", "R10", "S10")
    map.Add "Fostering a Culture of Feedback", Array("Q16", "R16", "S16")
    map.Add "ILI: Illinois Leadership Inventory", Array("Q22", "R22", "S22")
    map.Add "Sustainability and Leadership", Array("Q28", "R28", "S28")
    map.Add "Leading with Empathy and Compassion", Array("Q34", "R34", "S34")
    map.Add "Expressing Gratitude with Intention", Array("AB4", "AC4", "AD4")
    map.Add "Telling My Leadership Story", Array("AB10", "AC10", "AD10")
    map.Add "Entering Community Partnerships", Array("AB16", "AC16", "AD16")
    map.Add "Navigating Multicultural Organizations", Array("AB22", "AC22", "AD22")
    map.Add "Making Strategic Decisions", Array("AB28", "AC28", "AD28")

    facAvg = 0: contAvg = 0: recAvg = 0

    If Not map.Exists(workshopName) Then
        Debug.Print "WARNING: no fixed cell mapping for workshop '" & workshopName & "' - averages default to 0."
        Exit Sub
    End If

    Dim addrs As Variant
    addrs = map(workshopName)

    If Not IsError(calcWs.Range(addrs(0)).Value) Then facAvg = calcWs.Range(addrs(0)).Value
    If Not IsError(calcWs.Range(addrs(1)).Value) Then contAvg = calcWs.Range(addrs(1)).Value
    If Not IsError(calcWs.Range(addrs(2)).Value) Then recAvg = calcWs.Range(addrs(2)).Value

    Debug.Print "Averages for '" & workshopName & "': Facilitator=" & facAvg & " Content=" & contAvg & " Recommend=" & recAvg
End Sub

' Duplicates the correct arrow (Above/Below/Average) into each of the 3 box
' slots, then deletes the original 3 template arrows. Uses Shape.Duplicate
' instead of Copy/Paste - Copy/Paste through the clipboard is unreliable when
' called several times in quick succession (it can paste stale content).
'
' shpAbove/shpBelow/shpAvgArrow ("Above Arrow" / "Below Arrow" / "Average
' Arrow") are the fixed DIRECTION/GRAPHIC templates every new result arrow
' gets duplicated FROM - they say what the arrow looks like, not where it
' goes.
'
' shpFacBox/shpContBox/shpRecBox ("Facilitator Arrow" / "Content Arrow" /
' "Recommended Arrow") are empty rectangles that mark WHERE each arrow
' belongs and how big a footprint it has - the placed arrow is centered
' inside each rectangle's Left/Top/Width/Height. These boxes live in the
' "Workshop Layout" custom layout and are never deleted, so every slide has
' them in the same place.
'
' IMPORTANT NAME COLLISION NOTE: the box shapes are named "Facilitator
' Arrow" / "Content Arrow" / "Recommended Arrow" - the SAME strings used as
' the ResultArrow Tag value for the placed result arrows. That's fine for
' Tag-based lookups (RemoveAllShapesTagged/PlaceArrow only ever search by
' Tag, never by Name for the result arrows), but it means the placed result
' arrow must NOT reuse that string as its own .Name, or a later
' pptSlide.Shapes("Facilitator Arrow") lookup would become ambiguous
' between the box and the result arrow. So PlaceArrow tags the new shape
' "Facilitator Arrow" (matches RemoveAllShapesTagged) but names it
' "Facilitator Result Arrow" instead.
Private Sub UpdateComparisonArrows(pptSlide As Object, facilitatorPct As Double, contentPct As Double, recommendedPct As Double, facAvg As Double, contAvg As Double, recAvg As Double)
    Dim shpAbove As Object, shpBelow As Object, shpAvgArrow As Object
    Dim shpFacBox As Object, shpContBox As Object, shpRecBox As Object

    On Error Resume Next
    Set shpAbove = pptSlide.Shapes("Above Arrow")
    Set shpBelow = pptSlide.Shapes("Below Arrow")
    Set shpAvgArrow = pptSlide.Shapes("Average Arrow")

    ' Empty rectangles marking where/how big each arrow should be.
    Set shpFacBox = pptSlide.Shapes("Facilitator Arrow")
    Set shpContBox = pptSlide.Shapes("Content Arrow")
    Set shpRecBox = pptSlide.Shapes("Recommended Arrow")
    On Error GoTo 0

    If shpAbove Is Nothing Or shpBelow Is Nothing Or shpAvgArrow Is Nothing Then
        Debug.Print "WARNING: arrow template shape(s) not found (Above=" & (shpAbove Is Nothing) & _
                    " Below=" & (shpBelow Is Nothing) & " Average=" & (shpAvgArrow Is Nothing) & "), skipping arrow placement."
        Exit Sub
    End If

    If shpFacBox Is Nothing Or shpContBox Is Nothing Or shpRecBox Is Nothing Then
        Debug.Print "WARNING: arrow box shape(s) not found (Facilitator=" & (shpFacBox Is Nothing) & _
                    " Content=" & (shpContBox Is Nothing) & " Recommended=" & (shpRecBox Is Nothing) & "), skipping arrow placement."
        Exit Sub
    End If

    ' --- Safety-net cleanup: remove ANY preexisting RESULT arrows, identified
    ' by Tag (the direction templates and the empty boxes are untouched here -
    ' neither has a ResultArrow tag). ---
    RemoveAllShapesTagged pptSlide, "Facilitator Arrow"
    RemoveAllShapesTagged pptSlide, "Content Arrow"
    RemoveAllShapesTagged pptSlide, "Recommended Arrow"

    PlaceArrow shpAbove, shpBelow, shpAvgArrow, CompareToAverage(facilitatorPct, facAvg), shpFacBox, "Facilitator Arrow", "Facilitator Result Arrow"
    PlaceArrow shpAbove, shpBelow, shpAvgArrow, CompareToAverage(contentPct, contAvg), shpContBox, "Content Arrow", "Content Result Arrow"
    PlaceArrow shpAbove, shpBelow, shpAvgArrow, CompareToAverage(recommendedPct, recAvg), shpRecBox, "Recommended Arrow", "Recommended Result Arrow"

    ' --- Now that the correct duplicates are placed and tagged, it's safe to
    ' remove the original 3 direction/graphic templates. The empty boxes are
    ' left in place - they stay on every slide as invisible position/size
    ' markers for the next run. ---
    shpAbove.Delete
    shpBelow.Delete
    shpAvgArrow.Delete
End Sub

' Sets the three "X Percent Comparison" textboxes. Uses CompareToAverageForText,
' a WIDER tolerance than the arrows: anything within 4 percentage points of
' average (in either direction) reads as "about average" in the sentence, even
' if the arrow itself (which uses the strict CompareToAverage below) is
' showing a strict Above/Below result.
Private Sub UpdateComparisonTextBoxes(pptSlide As Object, facilitatorPct As Double, contentPct As Double, recommendedPct As Double, facAvg As Double, contAvg As Double, recAvg As Double)
    Dim shpFacText As Object, shpContText As Object, shpRecText As Object

    Set shpFacText = FindShapeByName(pptSlide, "Facilitator Comparison")
    Set shpContText = FindShapeByName(pptSlide, "Content Comparison")
    Set shpRecText = FindShapeByName(pptSlide, "Recommended Comparison")

    SetComparisonText shpFacText, CompareToAverageForText(facilitatorPct, facAvg)
    SetComparisonText shpContText, CompareToAverageForText(contentPct, contAvg)
    SetComparisonText shpRecText, CompareToAverageForText(recommendedPct, recAvg)
End Sub

' "Above"/"Below"/"Average", comparing rounded whole percents (matches the 0%
' display format). STRICT - no tolerance band. Used for the ARROWS only
' (UpdateComparisonArrows). Do not repoint this at the tolerance-band version
' below - that was the bug that made the arrows and the comparison sentences
' disagree (arrows were accidentally using the +/-4 point tolerance meant only
' for the sentences).
Private Function CompareToAverage(pct As Double, avg As Double) As String
    Dim pctRounded As Long, avgRounded As Long
    pctRounded = CLng(Application.WorksheetFunction.Round(pct * 100, 0))
    avgRounded = CLng(Application.WorksheetFunction.Round(avg * 100, 0))

    If pctRounded > avgRounded Then
        CompareToAverage = "Above"
    ElseIf pctRounded < avgRounded Then
        CompareToAverage = "Below"
    Else
        CompareToAverage = "Average"
    End If
End Function

' Same idea as CompareToAverage (rounded whole percents), but with a
' +/-4 percentage point tolerance band around average that reads as
' "Average" - used ONLY for the comparison SENTENCES (UpdateComparisonTextBoxes),
' never for the arrows.
Private Function CompareToAverageForText(pct As Double, avg As Double) As String
    Dim pctRounded As Long, avgRounded As Long
    Dim diff As Long

    pctRounded = CLng(Application.WorksheetFunction.Round(pct * 100, 0))
    avgRounded = CLng(Application.WorksheetFunction.Round(avg * 100, 0))
    diff = pctRounded - avgRounded

    If Abs(diff) <= 4 Then
        CompareToAverageForText = "Average"
    ElseIf diff > 0 Then
        CompareToAverageForText = "Above"
    Else
        CompareToAverageForText = "Below"
    End If
End Function

' Case-insensitive, whitespace-tolerant shape lookup by name, with logging.
' pptSlide.Shapes("exact name") is case-sensitive-ish and whitespace-strict
' enough that a trailing space or different capitalization in the actual
' shape name will silently fail to find it (especially under
' On Error Resume Next). This walks every shape and compares trimmed,
' lowercased names instead, and logs every shape name it sees so a
' mismatch is visible in the Immediate window (Ctrl+G).
Private Function FindShapeByName(pptSlide As Object, targetName As String) As Object
    Dim i As Long
    Dim shp As Object

    For i = 1 To pptSlide.Shapes.Count
        Set shp = pptSlide.Shapes(i)
        If LCase(Trim(shp.Name)) = LCase(Trim(targetName)) Then
            Set FindShapeByName = shp
            Exit Function
        End If
    Next i

    Debug.Print "WARNING: no shape found matching name '" & targetName & "'. Shapes on slide are:"
    For i = 1 To pptSlide.Shapes.Count
        Debug.Print "   [" & pptSlide.Shapes(i).Name & "]"
    Next i

    Set FindShapeByName = Nothing
End Function
' Writes the "For this type of workshop, this is ___ average." sentence
' into shp, with the blank filled in from resultType ("Above"/"Below"/"Average" -
' the same three values CompareToAverageForText returns).
Private Sub SetComparisonText(shp As Object, resultType As String)
    If shp Is Nothing Then
        Debug.Print "WARNING: comparison text shape not found, skipped."
        Exit Sub
    End If

    If Not shp.HasTextFrame Then
        Debug.Print "WARNING: shape '" & shp.Name & "' has no text frame, skipped."
        Exit Sub
    End If

    Dim comparisonWord As String
    Select Case resultType
        Case "Above": comparisonWord = "above"
        Case "Below": comparisonWord = "below"
        Case Else: comparisonWord = "about"
    End Select

    shp.TextFrame.TextRange.Text = "For this type of workshop, this is " & comparisonWord & " average."
    Debug.Print "Set '" & shp.Name & "' text to: " & shp.TextFrame.TextRange.Text
End Sub

' Deletes EVERY shape on pptSlide whose ResultArrow tag matches tagValue.
' Tags are used instead of Name because PowerPoint does not enforce unique
' shape names - a stale shape could share a name with a shape we intend to
' keep, or a rename could silently not "stick" in edge cases. Tags.Item
' returns "" (not an error) when the tag isn't set, so no error handling
' is needed around the lookup itself.
Private Sub RemoveAllShapesTagged(pptSlide As Object, tagValue As String)
    Dim i As Long
    Dim removedCount As Long
    removedCount = 0

    For i = pptSlide.Shapes.Count To 1 Step -1
        If pptSlide.Shapes(i).Tags("ResultArrow") = tagValue Then
            Debug.Print "Removing tagged shape: Name=[" & pptSlide.Shapes(i).Name & "] Tag=[" & tagValue & "]"
            pptSlide.Shapes(i).Delete
            removedCount = removedCount + 1
        End If
    Next i

    If removedCount > 0 Then
        Debug.Print "Removed " & removedCount & " shape(s) tagged: " & tagValue
    Else
        Debug.Print "No shapes found tagged: " & tagValue
    End If
End Sub

' Duplicates whichever master arrow matches resultType and centers the copy
' inside boxShape (using the box's own Left/Top/Width/Height, so the arrow's
' size relative to the box doesn't matter - it always ends up centered).
' Tags the new shape with "ResultArrow" = tagValue so it can be found and
' removed reliably later (see RemoveAllShapesTagged), and names it
' shapeName - kept deliberately DIFFERENT from boxShape's own name so a
' later Shapes("Facilitator Arrow")-style lookup of the box stays
' unambiguous (see the name-collision note above UpdateComparisonArrows).
Private Sub PlaceArrow(shpAbove As Object, shpBelow As Object, shpAvgArrow As Object, resultType As String, boxShape As Object, tagValue As String, shapeName As String)
    Dim masterShp As Object
    Dim newShp As Object

    Select Case resultType
        Case "Above": Set masterShp = shpAbove
        Case "Below": Set masterShp = shpBelow
        Case Else: Set masterShp = shpAvgArrow
    End Select

    Set newShp = masterShp.Duplicate.item(1)

    ' Center the arrow inside the box's bounds rather than snapping to its
    ' top-left corner.
    newShp.Left = boxShape.Left + (boxShape.Width - newShp.Width) / 2
    newShp.Top = boxShape.Top + (boxShape.Height - newShp.Height) / 2

    newShp.Name = shapeName
    newShp.Tags.Add "ResultArrow", tagValue
End Sub

' ===================== LEARNING OUTCOMES CHART =====================

' Rebuilds the "Learning Outcomes Chart" for the given workshop by writing
' DIRECTLY to the chart's SeriesCollection, not to the embedded ChartData
' workbook. This is a deliberate change from the earlier approach:
'
' Writing to ChartData.Workbook (an embedded Excel instance) and then trying
' to force PowerPoint to re-read it - via Chart.Refresh, toggling ChartType,
' or forcing a window repaint - never reliably worked, because none of those
' actually invalidate PowerPoint's cached rendering of an embedded chart.
' That cache is normally only invalidated as a side effect of a HUMAN
' opening and closing the Edit Data window.
'
' SeriesCollection(j).Values / .Name / .XValues write directly to the data
' the chart engine actually renders the PLOTTED VALUES from, so the bars
' update immediately and reliably. But the CATEGORY AXIS LABELS still only
' appeared after a human opened Edit Data, because the axis label cache is
' a separate store that isn't reliably re-derived from XValues alone.
'
' FIX: rather than fight the cache with redraw tricks (toggling ChartType,
' etc. - tried before, unreliable, and risks aborting the sub on error),
' just do programmatically exactly what a human does to invalidate it:
' open the embedded ChartData workbook, then immediately close it. This is
' wrapped in its own On Error Resume Next / On Error GoTo 0 pair so that if
' it ever fails for some reason (e.g. OLE activation hiccup), it can't take
' down the rest of the sub or the SeriesError handler below.
Private Sub UpdateWorkshopChart(shpChart As Object, workshopName As String, dataWs As Worksheet, calcWs As Worksheet)
    If shpChart Is Nothing Then
        Debug.Print "WARNING: Learning Outcomes Chart shape not found, skipped."
        Exit Sub
    End If

    If Not shpChart.HasChart Then
        Debug.Print "WARNING: shape '" & shpChart.Name & "' does not contain a chart, skipped."
        Exit Sub
    End If

    ' ---- Map: workshop -> 3 Data-tab columns (the sub-question columns) ----
    Dim colMap As Object
    Set colMap = CreateObject("Scripting.Dictionary")
    colMap.CompareMode = vbTextCompare
    colMap.Add "CliftonStrengths for Students: Self-Discovery", Array("N", "O", "P")
    colMap.Add "Addressing Conflict in Teams", Array("H", "I", "J")
    colMap.Add "Fostering a Culture of Feedback", Array("AF", "AG", "AH")
    colMap.Add "ILI: Illinois Leadership Inventory", Array("Z", "AA", "AB")
    colMap.Add "Sustainability and Leadership", Array("AI", "AJ", "AK")
    colMap.Add "Leading with Empathy and Compassion", Array("T", "U", "V")
    colMap.Add "Expressing Gratitude with Intention", Array("K", "L", "M")
    colMap.Add "Telling My Leadership Story", Array("W", "X", "Y")
    colMap.Add "Entering Community Partnerships", Array("AC", "AD", "AE")
    colMap.Add "Navigating Multicultural Organizations", Array("Q", "R", "S")
    colMap.Add "Making Strategic Decisions", Array("AL", "AM", "AN")

    ' ---- Map: workshop -> {label column, starting row} of its 3-cell row-label
    ' block on the Calculations sheet. Same block order as GetWorkshopAverages. ----
    Dim rowLabelMap As Object
    Set rowLabelMap = CreateObject("Scripting.Dictionary")
    rowLabelMap.CompareMode = vbTextCompare
    rowLabelMap.Add "CliftonStrengths for Students: Self-Discovery", Array("J", 4)
    rowLabelMap.Add "Addressing Conflict in Teams", Array("J", 10)
    rowLabelMap.Add "Fostering a Culture of Feedback", Array("J", 16)
    rowLabelMap.Add "ILI: Illinois Leadership Inventory", Array("J", 22)
    rowLabelMap.Add "Sustainability and Leadership", Array("J", 28)
    rowLabelMap.Add "Leading with Empathy and Compassion", Array("J", 34)
    rowLabelMap.Add "Expressing Gratitude with Intention", Array("U", 4)
    rowLabelMap.Add "Telling My Leadership Story", Array("U", 10)
    rowLabelMap.Add "Entering Community Partnerships", Array("U", 16)
    rowLabelMap.Add "Navigating Multicultural Organizations", Array("U", 22)
    rowLabelMap.Add "Making Strategic Decisions", Array("U", 28)

    If Not colMap.Exists(workshopName) Or Not rowLabelMap.Exists(workshopName) Then
        Debug.Print "WARNING: no chart mapping found for workshop '" & workshopName & "', chart skipped."
        Exit Sub
    End If

    Dim dataCols As Variant
    dataCols = colMap(workshopName)

    Dim labelInfo As Variant
    labelInfo = rowLabelMap(workshopName)
    Dim labelCol As String
    Dim labelStartRow As Long
    labelCol = labelInfo(0)
    labelStartRow = labelInfo(1)

    ' ---- Likert categories: chart series name -> matching Data-tab text ----
    Dim chartHeaders(1 To 5) As String
    chartHeaders(1) = "Strongly Disagree"
    chartHeaders(2) = "Disagree"
    chartHeaders(3) = "Neither"
    chartHeaders(4) = "Agree"
    chartHeaders(5) = "Strongly Agree"

    Dim dataTextMap(1 To 5) As String
    dataTextMap(1) = "strongly disagree"
    dataTextMap(2) = "somewhat disagree"
    dataTextMap(3) = "neither agree nor disagree"
    dataTextMap(4) = "somewhat agree"
    dataTextMap(5) = "strongly agree"

    ' ---- Build the 3x5 table (rows/labels reversed for the series flip, same
    ' as before). Each axis label is prefixed with "Can " (e.g. Calculations
    ' sheet text "describe the five..." becomes "Can describe the five..."). ----
    Dim rowLabels(1 To 3) As String
    Dim counts(1 To 3, 1 To 5) As Long

    Dim lastDataRow As Long
    lastDataRow = dataWs.Cells(dataWs.Rows.Count, 1).End(xlUp).Row

    Dim k As Long, j As Long, r As Long
    For k = 1 To 3
        Dim dataCol As String
        dataCol = dataCols(k - 1)

        Dim labelCell As String
        labelCell = labelCol & (labelStartRow + (k - 1))

        Dim targetRow As Long
        targetRow = 4 - k   ' k=1 -> row 3, k=2 -> row 2, k=3 -> row 1 (reversed order)

        rowLabels(targetRow) = "Can " & calcWs.Range(labelCell).Value

        For j = 1 To 5
            Dim cnt As Long
            cnt = 0
            For r = 2 To lastDataRow  ' assumes row 1 of Data tab is headers
                Dim cellVal As String
                cellVal = LCase(Trim(CStr(dataWs.Range(dataCol & r).Value)))
                If cellVal = dataTextMap(j) Then cnt = cnt + 1
            Next r
            counts(targetRow, j) = cnt
        Next j
    Next k

    ' ---- Write directly to the chart's SeriesCollection ----
    Dim cht As Object
    Set cht = shpChart.Chart

    On Error GoTo SeriesError

    Dim catArr(1 To 3) As String
    catArr(1) = rowLabels(1)
    catArr(2) = rowLabels(2)
    catArr(3) = rowLabels(3)

    For j = 1 To 5
        Dim ser As Object
        Set ser = cht.SeriesCollection(j)

        Dim valsArr(1 To 3) As Double
        valsArr(1) = counts(1, j)
        valsArr(2) = counts(2, j)
        valsArr(3) = counts(3, j)

        ser.values = valsArr
        ser.Name = chartHeaders(j)
        ser.XValues = catArr
    Next j

    On Error GoTo 0

    ' --- Invalidate PowerPoint's cached axis-label rendering by doing
    ' programmatically what a human does when they click Edit Data and
    ' close it again - open the embedded ChartData workbook, then
    ' immediately close it. This is what actually forces the new category
    ' labels to paint without requiring a manual click. Isolated error
    ' handling so a failure here can't abort the rest of the run. ---
    On Error Resume Next
    cht.ChartData.Activate
    DoEvents
    If Not cht.ChartData.Workbook Is Nothing Then
        cht.ChartData.Workbook.Close SaveChanges:=False
    End If
    On Error GoTo 0

    Debug.Print "Updated Learning Outcomes Chart for workshop: " & workshopName
    Exit Sub

SeriesError:
    Debug.Print "WARNING: failed writing chart series " & j & " for '" & workshopName & "' - Err " & Err.Number & ": " & Err.Description & ". Chart may not have exactly 5 series; check its series count matches the 5 Likert categories."
    On Error GoTo 0
End Sub


